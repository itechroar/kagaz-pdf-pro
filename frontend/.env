###############################################################################
# Frontend environment variables for the core build.
# Values can be overridden in the uncommitted sibling `.env.local` file.
# Note: This file is committed to Git, so should not contain any private keys.
###############################################################################

# API base URL — use / for same-origin (default for web builds)
VITE_API_BASE_URL=/

# Include the processor's lazy route/chunk. Gradle and Docker server builds turn
# it on; off for plain vite builds, always on in dev.
VITE_INCLUDE_PORTAL=false

# Image descriptions in the PDF text editor. Off until it ships; the end-to-end
# tests turn it on.
VITE_ACCESSIBILITY_EDITING=false

# Google Drive integration
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_APP_ID=

# Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Stripe checkout
VITE_STRIPE_PUBLISHABLE_KEY=

# PostHog analytics
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# Where the app's feedback entry points send people; leave blank for none
VITE_FEEDBACK_URL=

# Calendly scheduling link (portal "Schedule a call")
VITE_CALENDLY_URL=
