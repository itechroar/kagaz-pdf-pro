# Kagaz PDF configuration. Copy to .env (never commit .env). Everything is optional.

# --- Login and users -------------------------------------------------------
SECURITY_ENABLELOGIN=true
# First admin password. If empty a one-time password is printed in the server log.
KAGAZ_AUTH_ADMIN_PASSWORD=
# Let people create their own account on the user site (everyone must sign in either way).
KAGAZ_AUTH_SIGNUP_ENABLED=true
# Two sites, one server. Users: KAGAZ_USER_PORT. Administrators: KAGAZ_ADMIN_HOST_PORT, served only
# to this computer unless KAGAZ_ADMIN_HOST_BIND is 0.0.0.0 (do that only behind a firewall or VPN).
KAGAZ_USER_PORT=8080
KAGAZ_ADMIN_HOST_PORT=8081
KAGAZ_ADMIN_HOST_BIND=127.0.0.1
# Optional daily API-call cap per non-admin user (0 = unlimited)
KAGAZ_AUTH_QUOTA_DAILY_REQUESTS=0

# --- Offline mode ------------------------------------------------------------
# true = the AI assistant may only use a model server on this machine or your own network.
KAGAZ_OFFLINE=false

# --- AI document assistant (add your key later; nothing breaks while it is empty) ---
# anthropic | openai | gemini | openrouter | groq | mistral | together | deepseek | xai
# | ollama | lmstudio | vllm | custom        (empty = assistant off)
KAGAZ_AI_PROVIDER=
KAGAZ_AI_API_KEY=
# Defaults exist for anthropic, openai, gemini, groq, mistral, deepseek, ollama; others need a model.
KAGAZ_AI_MODEL=
# Only for custom/self-hosted servers, e.g. http://ollama:11434
KAGAZ_AI_BASE_URL=
# Long documents are read in parts of this many characters; no overall limit.
KAGAZ_AI_CHUNK_CHARS=30000
# OCR for scanned PDFs (Tesseract). Languages joined with +, e.g. eng+deu
KAGAZ_AI_OCR_LANGUAGES=eng

# --- Single sign-on (OpenID Connect). All three of the first block are required. -----
KAGAZ_AUTH_PUBLIC_URL=
KAGAZ_AUTH_OIDC_ISSUER=
KAGAZ_AUTH_OIDC_CLIENT_ID=
KAGAZ_AUTH_OIDC_CLIENT_SECRET=
KAGAZ_AUTH_OIDC_LABEL=Single sign-on
KAGAZ_AUTH_OIDC_SCOPES=openid email profile
KAGAZ_AUTH_OIDC_AUTO_CREATE=true
KAGAZ_AUTH_OIDC_ALLOWED_EMAIL_DOMAINS=
KAGAZ_AUTH_OIDC_ADMIN_EMAILS=

# --- Uploads: unlimited unless you set one, e.g. 500MB ---------------------------
# SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=-1

# Set true when served over HTTPS (marks the session cookie Secure)
KAGAZ_SECURE_COOKIES=false
