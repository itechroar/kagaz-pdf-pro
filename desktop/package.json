{
  "name": "kagaz-pdf-desktop",
  "version": "1.0.0",
  "description": "Desktop shell for Kagaz PDF: runs the bundled server locally and shows it in a window",
  "license": "Apache-2.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.kagazpdf.desktop",
    "productName": "Kagaz PDF",
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "resources/", "to": "server/", "filter": ["kagaz-pdf.jar", "jre/**/*"] }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
