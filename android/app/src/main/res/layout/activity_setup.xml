<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="28sp" android:textStyle="bold" />
    <EditText android:id="@+id/serverUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:hint="@string/server_hint"
        android:inputType="textUri" android:importantForAutofill="no" />
    <TextView android:id="@+id/error" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#B00020" android:visibility="gone" android:layout_marginTop="8dp" />
    <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/connect" />
</LinearLayout>
